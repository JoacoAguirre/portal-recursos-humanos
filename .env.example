# Claves públicas de Supabase (pueden estar disponibles en el navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor: invitaciones de usuarios y endpoint programado. Nunca usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Requerido solo si se habilita el cron.
CRON_SECRET=

# Configuración regional
APP_TIME_ZONE=America/Argentina/Buenos_Aires
